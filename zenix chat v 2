local function checkSecurityAndExecuteChat(textToSend)
    -- التحقق إذا كان اللاعب محاولاً تزييف تاق وهو ليس من المطورين
    if not t2[LocalPlayer.Name] then
        for tagKey,_ in pairs(tagToAltDisplayMap) do
            if textToSend:upper():find(tagKey:upper()) or LocalPlayer.DisplayName:upper():find(tagKey:upper()) then
                -- طرد التاق المزيف ومعاقبته برسالة الشات المطلوبة
                pcall(function()
                    LocalPlayer.DisplayName = "User_" .. math.random(1000, 9999)
                end)
                displayMessage("SYSTEM", "Fack tag LOL go away 😂", "System", true)
                return false
            end
        end
    end
    return true
end

local function sendMessage()
    local text = TextBox.Text
    if text == "" then return end

    if not checkSecurityAndExecuteChat(text) then
        TextBox.Text = ""
        return
    end

    local filtered = v6(text)
    TextBox.Text = ""
    displayMessage(LocalPlayer.DisplayName, filtered, LocalPlayer.Name, false)

    pcall(function()
        httpRequest({
            Url = chatUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({
                sender = LocalPlayer.DisplayName,
                content = filtered,
                realName = LocalPlayer.Name,
                target = "",
                timestamp = os.time(),
            })
        })
    end)
end

TextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then sendMessage() end
