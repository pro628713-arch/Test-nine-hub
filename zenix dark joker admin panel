local function executeCommand(action, targetName, params)
    if not action then return end
    params = params or {}
    action = string.lower(action)

    if action == "global_message" then
        local msgId = params.msg_id or (params.message .. tostring(os.time()))
        if msgId ~= LastGlobalMsgID then
            LastGlobalMsgID = msgId
            showTopGlobalMessage(params.message, params.title)
        end
        return
    end

    if not targetName or targetName == "" then return end
    local targetPlayer = Players:FindFirstChild(targetName)
    local isSelf = (targetName == LocalPlayer.Name)

    if action == "givesword" then
        local p = targetPlayer or LocalPlayer
        if params.enabled == false then
            removeThunderSword(p)
        else
            giveThunderSword(p)
        end

    elseif action == "jailmansion" then
        local p = targetPlayer or LocalPlayer
        if params.enabled == false then
            unloadGarden()
        else
            loadGarden(p)
        end

    elseif action == "jailhouse" then
        local p = targetPlayer or LocalPlayer
        if params.enabled == false then
            unloadHouse()
        else
            loadHouse(p)
        end

    elseif action == "backrooms" and isSelf then
        if params.enabled == false then
            cleanupBackrooms()
        else
            buildEntireBackroomsMode()
        end
    elseif action == "kick" and isSelf then
        LocalPlayer:Kick(params.reason or "تم طردك بواسطة zenix")
    elseif action == "kill" then
        if params.enabled ~= nil then
            ActiveLoops.LoopKill[targetName] = params.enabled
        else
            if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid") then
                targetPlayer.Character:FindFirstChildOfClass("Humanoid").Health = 0
            end
        end
    elseif action == "loopsit" or action == "loop_sit" then
        ActiveLoops.LoopSit[targetName] = (params.enabled ~= false)
    elseif action == "sit" then
        if params.enabled == false then
            if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid") then
                targetPlayer.Character:FindFirstChildOfClass("Humanoid").Sit = false
            end
        else
            if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid") then
                targetPlayer.Character:FindFirstChildOfClass("Humanoid").Sit = true
            end
        end
    elseif action == "fire" then
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = targetPlayer.Character.HumanoidRootPart
            if params.enabled == false then
                local fire = hrp:FindFirstChild("ZenixFire")
                if fire then fire:Destroy() end
            else
                if not hrp:FindFirstChild("ZenixFire") then
                    local fire = Instance.new("Fire", hrp)
                    fire.Name = "ZenixFire"
                    fire.Size = params.fire_size or 8
                end
            end
        end
    elseif action == "unfire" then
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local fire = targetPlayer.Character.HumanoidRootPart:FindFirstChild("ZenixFire")
            if fire then fire:Destroy() end
        end
    elseif action == "jail" or action == "jailcage" then
        local state = (params.enabled ~= false)
        ActiveLoops.Jail[targetName] = state
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = targetPlayer.Character.HumanoidRootPart
            if state then
                if not ActiveJails[targetName] then
                    local center = hrp.Position
                    local jailModel = Instance.new("Model", workspace)
                    jailModel.Name = "ZenixJail_" .. targetName
                    ActiveJails[targetName] = {Model = jailModel, Center = center}

                    local barColor = Color3.fromRGB(35, 35, 40)
                    local barMat = Enum.Material.Metal
                    local sizeX, sizeZ, height = 7, 7, 8
                    local halfX, halfZ = sizeX / 2, sizeZ / 2

                    local floor = Instance.new("Part", jailModel)
                    floor.Size = Vector3.new(sizeX + 1, 0.5, sizeZ + 1)
                    floor.CFrame = CFrame.new(center - Vector3.new(0, height/2, 0))
                    floor.Anchored = true
                    floor.Color = barColor
                    floor.Material = Enum.Material.DiamondPlate

                    local roof = Instance.new("Part", jailModel)
                    roof.Size = Vector3.new(sizeX + 1, 0.5, sizeZ + 1)
                    roof.CFrame = CFrame.new(center + Vector3.new(0, height/2, 0))
                    roof.Anchored = true
                    roof.Color = barColor
                    roof.Material = Enum.Material.DiamondPlate

                    local function createBar(pos)
                        local bar = Instance.new("Part", jailModel)
                        bar.Size = Vector3.new(0.3, height, 0.3)
                        bar.CFrame = CFrame.new(pos)
                        bar.Anchored = true
                        bar.Color = barColor
                        bar.Material = barMat
                    end

                    local step = 1.1
                    for x = -halfX, halfX, step do
                        createBar(center + Vector3.new(x, 0, halfZ))
                        createBar(center + Vector3.new(x, 0, -halfZ))
                    end
                    for z = -halfZ, halfZ, step do
                        createBar(center + Vector3.new(halfX, 0, z))
                        createBar(center + Vector3.new(-halfX, 0, z))
                    end
                end
            else
                if ActiveJails[targetName] then
                    ActiveJails[targetName].Model:Destroy()
                    ActiveJails[targetName] = nil
                end
            end
        end
    elseif action == "unjail" then
        ActiveLoops.Jail[targetName] = false
        if ActiveJails[targetName] then
            ActiveJails[targetName].Model:Destroy()
            ActiveJails[targetName] = nil
        end
        unloadHouse()
        unloadGarden()
    elseif action == "freeze" then
        if targetPlayer and targetPlayer.Character then
            for _, part in ipairs(targetPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.Anchored = (params.enabled ~= false) end
            end
        end
    elseif action == "unfreeze" then
        if targetPlayer and targetPlayer.Character then
            for _, part in ipairs(targetPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.Anchored = false end
            end
        end
    elseif action == "strip" or action == "cleartools" then
        if targetPlayer and targetPlayer.Backpack then
            targetPlayer.Backpack:ClearAllChildren()
        end
    elseif action == "unstrip" or action == "restoretools" then
        if targetPlayer then StarterPack:Clone().Parent = targetPlayer.Backpack end
    elseif action == "addhealth" then
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid") then
            local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
            hum.Health = math.min(hum.MaxHealth, hum.Health + (params.value or 100))
        end
    elseif action == "godmode" then
        ActiveLoops.GodMode[targetName] = (params.enabled ~= false)
    elseif action == "givebandage" then
        if targetPlayer and targetPlayer.Backpack then
            if params.enabled == false then
                if targetPlayer.Backpack:FindFirstChild("Bandage") then
                    targetPlayer.Backpack.Bandage:Destroy()
                end
            else
                local b = Instance.new("Tool")
                b.Name = "Bandage"
                b.Parent = targetPlayer.Backpack
            end
        end
    elseif action == "speed9999" then
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid") then
            local targetSpeed = (params.enabled == false) and 16 or (params.value or 9999)
            targetPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = targetSpeed
        end
    elseif action == "jump9999" then
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid") then
            local targetJump = (params.enabled == false) and 50 or (params.value or 9999)
            targetPlayer.Character:FindFirstChildOfClass("Humanoid").JumpPower = targetJump
        end
    elseif action == "autojump" then
        ActiveLoops.AutoJump[targetName] = (params.enabled ~= false)
    elseif action == "infjump" then
        ActiveLoops.InfJump[targetName] = (params.enabled ~= false)
    elseif action == "fling" then
        if params.enabled ~= false then
            if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = targetPlayer.Character.HumanoidRootPart
                local pwr = params.power or 500
                hrp.Velocity = Vector3.new(math.random(-pwr, pwr), pwr * 10, math.random(-pwr, pwr))
                hrp.RotVelocity = Vector3.new(9999, 9999, 9999)
            end
        end
    elseif action == "bring" then
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            targetPlayer.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(2, 0, 0)
        end
    elseif action == "spin200" or action == "spin" then
        ActiveLoops.Spin[targetName] = (params.enabled ~= false)
    elseif action == "blind" and isSelf then
        local pGuiBlind = LocalPlayer:FindFirstChild("PlayerGui")
        if pGuiBlind then
            local existing = pGuiBlind:FindFirstChild("ZenixBlindGui")
            if params.enabled ~= false then
                if not existing then
                    local sg = Instance.new("ScreenGui", pGuiBlind)
                    sg.Name = "ZenixBlindGui"
                    sg.ResetOnSpawn = false
                    local f = Instance.new("Frame", sg)
                    f.Size = UDim2.new(1, 0, 1, 0)
                    f.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                end
            else
                if existing then existing:Destroy() end
            end
        end
    elseif action == "sky" then
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            if params.enabled == false then
                targetPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
            else
                targetPlayer.Character.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 5000, 0)
            end
        end
    elseif action == "underground" then
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            if params.enabled == false then
                targetPlayer.Character.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 200, 0)
            else
                targetPlayer.Character.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame - Vector3.new(0, 200, 0)
            end
        end
    elseif action == "stopsky" then
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            targetPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
        end
    elseif action == "legback" or action == "legface" then
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            targetPlayer.Character.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(180), 0)
        end
    elseif action == "walkto" then
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            targetPlayer.Character:FindFirstChildOfClass("Humanoid"):MoveTo(LocalPlayer.Character.HumanoidRootPart.Position)
        end
    end
end

