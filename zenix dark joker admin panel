    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Sound") and (obj.Name == "BackroomsMusic" or obj.SoundId == "rbxassetid://122201260821898") then
            pcall(function() obj:Stop(); obj:Destroy() end)
        end
    end
    
    if workspace:FindFirstChild("BackroomsSystem") then 
        workspace.BackroomsSystem:Destroy() 
    end
    
    if LocalPlayer.Character then
        if LocalPlayer.Character:FindFirstChild("Humanoid") then LocalPlayer.Character.Humanoid.WalkSpeed = 16 end
        if LocalPlayer.Character:FindFirstChild("Flashlight") then LocalPlayer.Character.Flashlight:Destroy() end
    end
