            if parseSuccess and data then
                if data.timestamp and data.timestamp > LastProcessedTimestamp then
                    LastProcessedTimestamp = data.timestamp
                    if data.commands_schema then
                        for _, cmd in ipairs(data.commands_schema) do
                            if cmd.action and cmd.payload then
