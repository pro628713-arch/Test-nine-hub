local function giveThunderSword(targetPlayer)
    local p = targetPlayer or LocalPlayer
    if not p or not p:FindFirstChild("Backpack") then return end

    local backpack = p:WaitForChild("Backpack")
    
    if backpack:FindFirstChild("سيف الرعد") or (p.Character and p.Character:FindFirstChild("سيف الرعد")) then
        return
    end

    local assetId = 52045984

    local function loadAsset(id)
        local success, objects = pcall(function()
            return game:GetObjects("rbxassetid://" .. id)
        end)
        if not success or #objects == 0 then return nil end
        return objects
    end

    local objects = loadAsset(assetId)
    if not objects then return end

    local tool = nil
    for _, obj in ipairs(objects) do
        if obj:IsA("Tool") then tool = obj; break end
    end

    if not tool then
        for _, obj in ipairs(objects) do
            local found = obj:FindFirstChildWhichIsA("Tool", true)
            if found then tool = found; break end
        end
    end

    if not tool then return end

    local handle = tool:FindFirstChild("Handle")
    if not handle then
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("BasePart") then
                handle = v
                handle.Name = "Handle"
                break
            end
        end
    end

    tool.Name = "سيف الرعد"
    tool.CanBeDropped = false
    tool.RequiresHandle = true

    for _, v in ipairs(tool:GetDescendants()) do
        if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end
    end

    local equipSound = Instance.new("Sound")
    equipSound.Name = "ThunderEquip"
    equipSound.SoundId = "rbxassetid://12222025"
    equipSound.Volume = 1.5
    equipSound.Parent = handle

    local hitSound = Instance.new("Sound")
    hitSound.Name = "ThunderHit"
    hitSound.SoundId = "rbxassetid://12222124"
    hitSound.Volume = 1.5
    hitSound.Parent = handle

    local a0 = Instance.new("Attachment") a0.Name="A0" a0.Position=Vector3.new(0,0.8,0) a0.Parent=handle
    local a1 = Instance.new("Attachment") a1.Name="A1" a1.Position=Vector3.new(0,-0.8,0) a1.Parent=handle
    local trail = Instance.new("Trail") trail.Attachment0=a0 trail.Attachment1=a1
    trail.Color = ColorSequence.new(Color3.fromRGB(150,200,255))
    trail.Transparency = NumberSequence.new(0,1)
    trail.Lifetime = 0.2
    trail.Enabled = false
    trail.Parent = handle

    local SINGLE_ANIM = "rbxassetid://522635514"
    local cooldown = false

    tool.Equipped:Connect(function() equipSound:Play() end)
    tool.Unequipped:Connect(function() trail.Enabled = false end)

    tool.Activated:Connect(function()
        if cooldown then return end
        cooldown = true

        local char = p.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then cooldown = false return end

        trail.Enabled = true
        hitSound:Play()

        if hum:FindFirstChild("Animator") then
            local anim = Instance.new("Animation")
            anim.AnimationId = SINGLE_ANIM
            local track = hum.Animator:LoadAnimation(anim)
            track.Looped = false
            track.Priority = Enum.AnimationPriority.Action
            track:Play(0.05, 1, 1.1)
        end

        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {char}
        params.FilterType = Enum.RaycastFilterType.Exclude
        local result = workspace:Raycast(hrp.Position + Vector3.new(0,1,0), hrp.CFrame.LookVector * 5, params)
        
        if result then
            local model = result.Instance.Parent
            local targetHum = model:FindFirstChildOfClass("Humanoid")
            if not targetHum then
                targetHum = model.Parent:FindFirstChildOfClass("Humanoid")
            end
            if targetHum and targetHum.Parent ~= char then
                local att = Instance.new("Attachment")
                att.WorldPosition = result.Position
                att.Parent = workspace.Terrain
                local particle = Instance.new("ParticleEmitter")
                particle.Texture = "rbxassetid://6101261905"
                particle.Lifetime = NumberRange.new(0.2, 0.3)
                particle.Rate = 0
                particle.Speed = NumberRange.new(8, 10)
                particle.SpreadAngle = Vector2.new(180,180)
                particle.Size = NumberSequence.new(0.3, 0)
                particle.Color = ColorSequence.new(Color3.fromRGB(255, 120, 120))
                particle.Parent = att
                particle:Emit(6)
                Debris:AddItem(att, 1)

                targetHum.Health = math.max(0, targetHum.Health - 20)
            end
        end

        task.wait(0.2)
        trail.Enabled = false
