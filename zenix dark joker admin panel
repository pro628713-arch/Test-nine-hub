    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        startPos = Vector3.new(LocalPlayer.Character.HumanoidRootPart.Position.X, 500, LocalPlayer.Character.HumanoidRootPart.Position.Z)
    end

    local folder = Instance.new("Folder", workspace)
    folder.Name = "BackroomsSystem"

    BackroomsSound = Instance.new("Sound")
    BackroomsSound.Name = "BackroomsMusic"
    BackroomsSound.SoundId = "rbxassetid://122201260821898"
    BackroomsSound.Looped = true
    BackroomsSound.Volume = 0.8
    BackroomsSound.Parent = folder
    BackroomsSound:Play()

    local tileSize, gridRadius, wallHeight = 26, 26, 16
    local wallColor = Color3.fromRGB(235, 215, 130)
    local floorColor = Color3.fromRGB(185, 165, 100)
    local roofColor = Color3.fromRGB(215, 205, 165)
    local outerBound = (gridRadius + 1) * tileSize

    local function createPart(size, pos, color, mat, parent)
        local p = Instance.new("Part", parent)
        p.Size, p.Position, p.Color, p.Material, p.Anchored = size, pos, color, mat, true
        return p
    end

    createPart(Vector3.new(outerBound * 2, 1, outerBound * 2), startPos, floorColor, Enum.Material.Fabric, folder)
    createPart(Vector3.new(outerBound * 2, 1, outerBound * 2), startPos + Vector3.new(0, wallHeight, 0), roofColor, Enum.Material.SmoothPlastic, folder)

    createPart(Vector3.new(outerBound * 2, wallHeight, 2), startPos + Vector3.new(0, wallHeight/2, -outerBound), wallColor, Enum.Material.SmoothPlastic, folder)
    createPart(Vector3.new(outerBound * 2, wallHeight, 2), startPos + Vector3.new(0, wallHeight/2, outerBound), wallColor, Enum.Material.SmoothPlastic, folder)
    createPart(Vector3.new(2, wallHeight, outerBound * 2), startPos + Vector3.new(-outerBound, wallHeight/2, 0), wallColor, Enum.Material.SmoothPlastic, folder)
    createPart(Vector3.new(2, wallHeight, outerBound * 2), startPos + Vector3.new(outerBound, wallHeight/2, 0), wallColor, Enum.Material.SmoothPlastic, folder)

    for x = -gridRadius, gridRadius do
        for z = -gridRadius, gridRadius do
            local posX, posZ = startPos.X + (x * tileSize), startPos.Z + (z * tileSize)
            if (x + z) % 3 == 0 then
                local light = createPart(Vector3.new(6, 0.2, 3), Vector3.new(posX, startPos.Y + wallHeight - 0.2, posZ), Color3.fromRGB(255, 255, 210), Enum.Material.Neon, folder)
                local pt = Instance.new("PointLight", light)
                pt.Brightness, pt.Range, pt.Color = 1.8, 28, Color3.fromRGB(255, 240, 180)
            end
            local seed = math.abs(math.sin(x * 15.123 + z * 47.891 + math.cos(x * z) * 0.5) * 43758.5453) % 1
            if seed > 0.38 then
                createPart(Vector3.new(tileSize, wallHeight, 1.4), Vector3.new(posX, startPos.Y + (wallHeight/2), posZ - (tileSize/2)), wallColor, Enum.Material.SmoothPlastic, folder)
            end
            if seed < 0.42 then
                createPart(Vector3.new(1.4, wallHeight, tileSize), Vector3.new(posX - (tileSize/2), startPos.Y + (wallHeight/2), posZ), wallColor, Enum.Material.SmoothPlastic, folder)
            end
        end
    end

    local doorY = startPos.Y + 5
    local exitWallPos = Vector3.new(startPos.X + outerBound - 1.2, doorY, startPos.Z + (gridRadius - 2) * tileSize)
    createPart(Vector3.new(0.6, 10, 6), exitWallPos, Color3.fromRGB(50, 35, 25), Enum.Material.Wood, folder)
    local exitDoor = createPart(Vector3.new(0.7, 9.2, 5.2), exitWallPos - Vector3.new(0.1, 0, 0), Color3.fromRGB(255, 255, 255), Enum.Material.Neon, folder)
