    if CurrentCC then CurrentCC:Destroy(); CurrentCC = nil end
    if CurrentBlur then CurrentBlur:Destroy(); CurrentBlur = nil end

    BackroomsMonsters, OccupiedPositions, ExitCFrame = {}, {}, nil
end

local function getRandomPos(startPos, gridRadius, tileSize, minDistFromStart)
    minDistFromStart = minDistFromStart or 0
    for _ = 1, 80 do
        local rx, rz = math.random(-gridRadius + 3, gridRadius - 3), math.random(-gridRadius + 3, gridRadius - 3)
        local candidate = Vector3.new(startPos.X + (rx * tileSize), startPos.Y + 3, startPos.Z + (rz * tileSize))
        if (candidate - startPos).Magnitude >= minDistFromStart then
            local valid = true
            for _, pos in ipairs(OccupiedPositions) do
                if (pos - candidate).Magnitude < 35 then valid = false break end
            end
            if valid then table.insert(OccupiedPositions, candidate) return candidate end
        end
    end
    local pos = Vector3.new(startPos.X + (math.random(-gridRadius + 3, gridRadius - 3) * tileSize), startPos.Y + 3, startPos.Z + (math.random(-gridRadius + 3, gridRadius - 3) * tileSize))
    table.insert(OccupiedPositions, pos)
    return pos
end

local function spawnScatteredItem(folder, startPos, gridRadius, tileSize, sourceObject, name, actionText, effectFunc)
    if not sourceObject then return end
    local pos = getRandomPos(startPos, gridRadius, tileSize, 15)
    local clone = sourceObject:Clone()
    clone.Name = name .. "Ground"
    
    local primary = clone:IsA("Model") and (clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart")) or (clone:IsA("BasePart") and clone)
    if primary then
        if clone:IsA("Model") then
            clone:SetPrimaryPartCFrame(CFrame.new(pos.X, startPos.Y + 1, pos.Z))
        else
            clone.CFrame = CFrame.new(pos.X, startPos.Y + 1, pos.Z)
            clone.Anchored = true
            clone.CanCollide = false
        end

        local promptPart = clone:IsA("Model") and (clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart")) or clone
        local prompt = Instance.new("ProximityPrompt", promptPart)
        prompt.ObjectText, prompt.ActionText, prompt.HoldDuration, prompt.MaxActivationDistance = name, actionText, 0.1, 9

        prompt.Triggered:Connect(function(player)
            clone:Destroy()
            local tool = Instance.new("Tool")
            tool.Name, tool.RequiresHandle, tool.CanBeDropped = name, true, true
            
            local handle = promptPart:Clone()
            handle.Name = "Handle"
            handle.Anchored, handle.CanCollide, handle.Transparency = false, false, 0
            handle.Parent = tool

            tool.Activated:Connect(function()
                if player.Character and player.Character:FindFirstChild("Humanoid") then
                    effectFunc(player, tool)
                end
            end)
            tool.Parent = player.Backpack
        end)
        clone.Parent = folder
    end
end

local function spawnMonsters(folder, startPos, gridRadius, tileSize)
    local sourceMonster = workspace:FindFirstChild("Backrooms monster")
    for i = 1, 3 do
        local mPos = getRandomPos(startPos, gridRadius, tileSize, 90 + (i * 35))
        if sourceMonster then
            local monster = sourceMonster:Clone()
            monster.Name = "BackroomsMonster_"..i
            
            pcall(function()
                if monster:IsA("Model") then
                    for _, d in ipairs(monster:GetDescendants()) do
                        if d:IsA("BasePart") then d.Size = d.Size * 0.9 end
                    end
                end
            end)

            local root = monster:FindFirstChild("HumanoidRootPart") or monster:FindFirstChildWhichIsA("BasePart")
            if root then
                if monster:IsA("Model") then
                    monster:SetPrimaryPartCFrame(CFrame.new(mPos + Vector3.new(0, 5, 0)))
                else
                    root.CFrame = CFrame.new(mPos + Vector3.new(0, 5, 0))
                end
            end
            monster.Parent = folder
            table.insert(BackroomsMonsters, {Model = monster, Body = root, LastHit = 0, NextPathTick = 0, Waypoints = {}, CurrentWaypointIndex = 1})
        end
    end
end

