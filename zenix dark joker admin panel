    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BasePart") then
            local nameLower = obj.Name:lower()
            if nameLower:find("door") or nameLower:find("entrance") or nameLower:find("gate") or nameLower:find("main") then
                doorPart = obj
                break
            end
        end
