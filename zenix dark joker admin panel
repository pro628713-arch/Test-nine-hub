-- 12. محرك الإرسال عبر API مع حذف البيانات من Firebase وإرسال شات شكلي
-- =====================================================
local function clearFirebaseCommand(endpoint)
    if not httpRequest then return end
    pcall(function()
        httpRequest({
            Url = BASE_API_URL .. endpoint .. ".json",
            Method = "DELETE"
        })
    end)
end

local function sendAPICommand(action, customParams)
    if TargetPlayer == "" and action ~= "global_message" then
        WindUI:Notify({ Title = "تنبيه", Content = "يرجى اختيار لاعب مستهدف أولاً!", Duration = 3 })
        return
    end

    local schema = CommandsSchema[action]
    if not schema then return end

    local payloadData = {}
    if schema.payload then
        for k, v in pairs(schema.payload) do payloadData[k] = v end
    end
    if customParams then
        for k, v in pairs(customParams) do payloadData[k] = v end
    end
    payloadData.target = (action == "global_message") and "All" or TargetPlayer
    payloadData.timestamp = os.time()

    -- إرسال رسالة وهمية في الشات العام (شكلية فقط)
    if action ~= "global_message" and payloadData.target ~= "" then
        sendFakeChatMessage("/" .. action .. " " .. payloadData.target)
    end

    local singleCommandObject = {
        action = action,
        endpoint = schema.endpoint,
        method = schema.method,
        payload = payloadData
    }

    local rootRequestBody = {
        api_version = "2.1",
        commands_schema = { singleCommandObject },
        sender = LocalPlayer.Name,
        timestamp = os.time()
    }

    if httpRequest then
        pcall(function()
            httpRequest({
                Url = BASE_API_URL .. schema.endpoint .. ".json",
                Method = "PATCH",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(singleCommandObject)
            })
        end)

        pcall(function()
            httpRequest({
                Url = BASE_API_URL .. "/.json",
                Method = "PATCH",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(rootRequestBody)
            })
        end)
    end

    -- تنفيذ الأمر محلياً
    executeCommand(action, payloadData.target, payloadData)

    -- مسح الأمر من Firebase فوراً لمنع التكرار (Spam)
    task.delay(0.5, function()
        clearFirebaseCommand(schema.endpoint)
    end)

    WindUI:Notify({
        Title = "تم الإرسال بنجاح",
        Content = "الأمر: " .. action .. " | الهدف: " .. payloadData.target,
        Duration = 2
    })
end

