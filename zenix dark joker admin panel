    task.spawn(function()
        while CurrentBlur and CurrentBlur.Parent do
            for i = 0, 6 do if not CurrentBlur or not CurrentBlur.Parent then break end CurrentBlur.Size = i task.wait(0.08) end
            for i = 6, 0, -1 do if not CurrentBlur or not CurrentBlur.Parent then break end CurrentBlur.Size = i task.wait(0.08) end
