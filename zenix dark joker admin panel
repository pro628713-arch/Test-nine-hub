        t:Destroy()
    end) end

    for _ = 1, 6 do spawnScatteredItem(folder, startPos, gridRadius, tileSize, bandageSource, "Bandage", "أخذ Bandage (+30 صحة)", function(p, t)
        local hum = p.Character.Humanoid
        hum.Health = math.min(hum.MaxHealth, hum.Health + 30)
        showEffectNotification("🩹 استخدمت Bandage (+30 صحة)!", Color3.fromRGB(255, 200, 100))
        t:Destroy()
    end) end

    for _ = 1, 5 do spawnScatteredItem(folder, startPos, gridRadius, tileSize, energySource, "Monster Energy", "أخذ مشروب الطاقة (+12 سرعة)", function(p, t)
        local hum = p.Character.Humanoid
        hum.WalkSpeed = hum.WalkSpeed + 12
        showEffectNotification("⚡ شربت Monster Energy (+12 سرعة)!", Color3.fromRGB(50, 150, 255))
        t:Destroy()
    end) end

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(startPos + Vector3.new(0, 4, 0))
    end

    BackroomsMainLoop = task.spawn(function()
        while task.wait(0.05) do
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                local hrp, hum = char.HumanoidRootPart, char.Humanoid
                local pPos = hrp.Position

                for _, mData in ipairs(BackroomsMonsters) do
                    if mData.Body and mData.Body.Parent then
                        local mBody = mData.Body
                        local mPos = mBody.Position
                        local dist = (pPos - mPos).Magnitude

                        if dist <= 150 then
                            if tick() >= mData.NextPathTick then
                                mData.NextPathTick = tick() + 0.9
                                local path = PathfindingService:CreatePath({AgentRadius = 3, AgentHeight = 10})
                                local success = pcall(function() path:ComputeAsync(mPos, pPos) end)
                                if success and path.Status == Enum.PathStatus.Success then
                                    mData.Waypoints = path:GetWaypoints()
                                    mData.CurrentWaypointIndex = 2
                                end
                            end

                            if mData.Waypoints and #mData.Waypoints >= mData.CurrentWaypointIndex then
                                local targetWP = mData.Waypoints[mData.CurrentWaypointIndex].Position
                                if (Vector3.new(targetWP.X, mPos.Y, targetWP.Z) - mPos).Magnitude < 4 then
                                    mData.CurrentWaypointIndex = mData.CurrentWaypointIndex + 1
                                end
                                if mData.Waypoints[mData.CurrentWaypointIndex] then
                                    local nextTarget = mData.Waypoints[mData.CurrentWaypointIndex].Position
                                    local moveDir = (Vector3.new(nextTarget.X, mPos.Y, nextTarget.Z) - mPos).Unit
                                    local step = moveDir * (22 * 0.05)
                                    if mData.Model:IsA("Model") then
                                        mData.Model:SetPrimaryPartCFrame(CFrame.new(mPos + step, Vector3.new(nextTarget.X, mPos.Y, nextTarget.Z)))
                                    else
                                        mBody.CFrame = CFrame.new(mPos + step, Vector3.new(nextTarget.X, mPos.Y, nextTarget.Z))
                                    end
                                end
                            else
                                local dir = (pPos - mPos).Unit
                                local step = dir * (22 * 0.05)
                                if mData.Model:IsA("Model") then
                                    mData.Model:SetPrimaryPartCFrame(CFrame.new(mPos + step, Vector3.new(pPos.X, mPos.Y, pPos.Z)))
                                else
                                    mBody.CFrame = CFrame.new(mPos + step, Vector3.new(pPos.X, mPos.Y, pPos.Z))
                                end
                            end

                            if dist <= 8 and tick() - mData.LastHit >= 1.2 then
                                mData.LastHit = tick()
                                hum.Health = math.max(0, hum.Health - 40)
                            end
                        end
                    end
                end
            end
        end
    end)
end

