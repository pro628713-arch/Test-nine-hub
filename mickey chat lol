                wingL.motor.C0 = CFrame.new(-2.5, 3.5 + bob, 2.5) * CFrame.Angles(math.rad(155 + sway * 20), -0.2617993877991494, 0.2617993877991494)
                wingR.motor.C0 = CFrame.new(2.5, 3.5 + bob, 2.5) * CFrame.Angles(math.rad(155 + sway * 20), 0.2617993877991494, -0.2617993877991494)

                for k, v in pairs(wingL.joints) do
                    v.C1 = CFrame.Angles(0, 0, math.sin(t + k) * 0.03)
                end
                for k, v in pairs(wingR.joints) do
                    v.C1 = CFrame.Angles(0, 0, math.sin(t + k) * 0.03)
                end

                RunService.Heartbeat:Wait()
            end
        end)
    end

    -- Normal Halo (u159)
    function u159(player, rootPart, model)
        local color = Color3.fromRGB(255, 255, 255)
        local halos = {}
        for i = 1, 6 do
            local p = Instance.new("Part", model)
            p.Shape = Enum.PartType.Ball
            p.Size = Vector3.new(0.5, 0.5, 0.5)
            p.Material = Enum.Material.Neon
            p.Color = color
            p.Transparency = 0.3
            disablePhysics(p)

            local motor = Instance.new("Motor6D", p)
            motor.Part0 = rootPart
            motor.Part1 = p
            local angle = i / 6 * 2 * math.pi
            motor.C0 = CFrame.new(math.cos(angle) * 1.3, 4.5, math.sin(angle) * 1.3)

            table.insert(halos, { part = p, weld = motor, baseAngle = angle })
        end

        task.spawn(function()
            while model and model.Parent do
                if player == LocalPlayer and not u5 then
                    for _, v in pairs(halos) do v.part.Transparency = 1 end
                    repeat RunService.Heartbeat:Wait() until u5 or not model.Parent
                    for _, v in pairs(halos) do v.part.Transparency = 0.3 end
                end

                local t = tick()
                for _, v in pairs(halos) do
                    local angle = v.baseAngle + t * 0.3
                    v.weld.C0 = CFrame.new(math.cos(angle) * 1.3, 4.5 + 0.1 * math.sin(t * 1.5), math.sin(angle) * 1.3)
                    v.part.Transparency = 0.2 + 0.1 * math.sin(t * 2 + v.baseAngle)
                end
                RunService.Heartbeat:Wait()
            end
        end)
    end

    -- Big Sniper (u161)
    function u161(player, rootPart, model)
        local colors = {
            dark = Color3.fromRGB(20, 20, 20),
            white = Color3.fromRGB(255, 255, 255),
            neon = Color3.fromRGB(255, 255, 255),
            gray = Color3.fromRGB(40, 40, 40),
            darkGray = Color3.fromRGB(30, 30, 30),
        }

        local parts = {}
        local function makePart(parent, size, material, color, cframe, shape)
            local p = Instance.new("Part", parent)
            p.Size = size
            p.Material = material
            p.Color = color
            if shape then p.Shape = shape end
            disablePhysics(p)
            if cframe then p.CFrame = cframe end
            return p
        end

        local barrel = makePart(model, Vector3.new(1.2, 0.9, 3.2), Enum.Material.Metal, colors.dark)
        local barrelLong = makePart(model, Vector3.new(0.45, 0.45, 8), Enum.Material.Metal, colors.dark)
        local scope = makePart(model, Vector3.new(0.8, 0.8, 1.4), Enum.Material.Metal, colors.dark)
        local scopeLens = makePart(model, Vector3.new(0.7, 0.7, 0.4), Enum.Material.Neon, colors.neon, nil, Enum.PartType.Cylinder)
        local handle = makePart(model, Vector3.new(0.7, 1, 1.2), Enum.Material.Metal, colors.gray)
        local trigger = makePart(model, Vector3.new(0.3, 0.2, 0.3), Enum.Material.Metal, colors.white)
        local grip = makePart(model, Vector3.new(0.7, 1.2, 1.2), Enum.Material.Metal, colors.gray)
        local stock = makePart(model, Vector3.new(1, 0.8, 3), Enum.Material.Metal, colors.dark)
        local stockPad = makePart(model, Vector3.new(0.5, 0.3, 0.8), Enum.Material.Metal, colors.gray)
        local bipod = makePart(model, Vector3.new(1.5, 1.2, 0.6), Enum.Material.Metal, colors.dark)
        local leg1 = makePart(model, Vector3.new(0.4, 0.8, 0.5), Enum.Material.Metal, colors.gray)
        local leg2 = makePart(model, Vector3.new(0.4, 0.8, 0.5), Enum.Material.Metal, colors.gray)
        local bipodPad = makePart(model, Vector3.new(1.6, 1.3, 0.3), Enum.Material.Rubber, colors.darkGray)

        -- Main motor
        local motor = Instance.new("Motor6D")
        motor.Part0 = rootPart
        motor.Part1 = barrel
        motor.C0 = CFrame.new(2.5, 1.5, 1) * CFrame.Angles(0, math.pi, 0)
        motor.Parent = barrel

        -- Welds
        local function weld(a, b, cframe)
            local w = Instance.new("Weld", a)
            w.Part0 = a
            w.Part1 = b
            w.C0 = cframe
        end

        weld(barrel, barrelLong, CFrame.new(0, 0.1, barrel.Size.Z / 2 + barrelLong.Size.Z / 2))
        weld(barrel, scope, CFrame.new(0, 0.6, -0.9))
        weld(scope, scopeLens, CFrame.new(0, 0, 0.7))
        weld(barrel, handle, CFrame.new(0.5, -0.4, -1.2))
        weld(handle, trigger, CFrame.new(0, -0.6, 0.2))
        weld(barrel, grip, CFrame.new(-0.5, -0.6, -0.4))
        weld(barrel, stock, CFrame.new(0, 0.1, -barrel.Size.Z / 2 - stock.Size.Z / 2))
        weld(stock, stockPad, CFrame.new(0, 0.6, -1.5))
        weld(stock, bipod, CFrame.new(0, -0.5, -stock.Size.Z / 2 - bipod.Size.Z / 2))
        weld(bipod, leg1, CFrame.new(-0.8, 0.3, 0))
        weld(bipod, leg2, CFrame.new(0.8, 0.3, 0))
        weld(bipod, bipodPad, CFrame.new(0, 0, -bipod.Size.Z / 2 - bipodPad.Size.Z / 2))

        task.spawn(function()
            while model and model.Parent do
                if player == LocalPlayer and not u5 then
                    for _, child in pairs(model:GetChildren()) do
                        if child:IsA("BasePart") then child.Transparency = 1 end
                    end
                    repeat RunService.Heartbeat:Wait() until u5 or not model.Parent
                    for _, child in pairs(model:GetChildren()) do
                        if child:IsA("BasePart") then child.Transparency = 0 end
                    end
                end

                local t = tick()
                motor.C0 = CFrame.new(2.5 + math.sin(t * 0.8) * 0.1, 1.5 + math.sin(t * 2) * 0.1, 1) * CFrame.Angles(0, math.pi, 0)
                scopeLens.Transparency = 0.3 + 0.2 * math.sin(t * 3)
                RunService.Heartbeat:Wait()
            end
        end)
    end

    -- Illuminati (u162)
    function u162(player, rootPart, model)
        local base = Instance.new("Part", model)
