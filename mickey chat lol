        local text = TextBox.Text
        if text == "" then return end

        local blocked, reason = filterMessage(text)
        if blocked then
            displayMessage("SYSTEM", "🚫 Message blocked: " .. reason, "System", true, "")
            TextBox.Text = ""
            return
        end

        local filtered = v6(text)
        if filtered == "" or filtered:match("^%s*$") then
            displayMessage("SYSTEM", "🚫 Message empty after filtering", "System", true, "")
            TextBox.Text = ""
            return
        end

        if #filtered > 200 then
            displayMessage("SYSTEM", "📏 Message too long (max 200 chars)", "System", true, "")
            TextBox.Text = ""
            return
        end

        local elapsed = os.clock()
        if elapsed - n1 < 2 then
            TextBox.Text = ""
            return
        end

        n1 = elapsed
        TextBox.Text = ""
        displayMessage(LocalPlayer.DisplayName, filtered, LocalPlayer.Name, false, s1)

        task.spawn(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
                TextChatService:DisplayBubble(LocalPlayer.Character.Head, filtered)
