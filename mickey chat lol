    -- ===== Sync Loop (Aura + Messages) =====
    local syncedStyles = {}
    local processedMessages = {}

    local function syncLoop()
        -- Fetch auras
        pcall(function()
            local resp = httpRequest({ Url = auraUrl, Method = "GET" })
            if resp and resp.Body and resp.Body ~= "null" then
                local data = HttpService:JSONDecode(resp.Body) or {}
                for name, styleData in pairs(data) do
                    if syncedStyles[name] ~= styleData.Style then
                        syncedStyles[name] = styleData.Style
                        local player = Players:FindFirstChild(name)
                        if player and player.Character then
                            local root = player.Character:FindFirstChild("HumanoidRootPart")
                            if root then
                                if player.Character:FindFirstChild("MickeyAura") then
                                    player.Character.MickeyAura:Destroy()
                                end
                                local model = Instance.new("Model", player.Character)
                                model.Name = "MickeyAura"
                                local style = styleData.Style
                                if style == "DIVINE_RING" then u153(player, root, model)
                                elseif style == "HYDRA_STRIKE" then u154(player, root, model)
                                elseif style == "DEMON_HANDS" then u156(player, root, model)
                                elseif style == "HEART_AURA" then u155(player, root, model)
                                elseif style == "LETTER_A" then u157(player, root, model)
                                elseif style == "LETTER_N" then u158(player, root, model)
                                elseif style == "NORMAL_HALO" then u159(player, root, model)
                                elseif style == "ANGEL_WINGS" then u160(player, root, model)
                                elseif style == "BIG_SNIPER" then u161(player, root, model)
                                elseif style == "ILLUMINATI" then u162(player, root, model)
                                end
                            end
                        end
                    end
                end
            end
        end)

        -- Fetch recent messages
        local ok, resp = pcall(function()
            return httpRequest({ Url = chatUrl .. '&orderBy="$key"&limitToLast=10', Method = "GET" })
        end)

        if ok and resp and resp.Body and resp.Body ~= "null" then
            local success, data = pcall(function() return HttpService:JSONDecode(resp.Body) end)
            if success and type(data) == "table" then
                for key, msg in pairs(data) do
                    if not processedMessages[key] and msg.timestamp and msg.timestamp >= timestamp then
                        -- Check for fake tags
                        local realPlayer = Players:FindFirstChild(msg.realName)
                        if realPlayer and realPlayer.DisplayName ~= msg.sender then
                            local warning = "😂 YE FAKE TAG RNDY " .. realPlayer.DisplayName .. " → " .. msg.sender
                            pcall(function()
                                httpRequest({
                                    Url = chatUrl,
                                    Method = "POST",
                                    Headers = { ["Content-Type"] = "application/json" },
                                    Body = HttpService:JSONEncode({
                                        sender = "BOT",
                                        content = warning,
                                        realName = "ChatBot",
                                        target = "",
                                        timestamp = os.time(),
                                    })
                                })
                            end)
                            msg.sender = realPlayer.DisplayName
                        end

                        processedMessages[key] = true

                        if msg.realName ~= LocalPlayer.Name and not t2[msg.realName] then
                            displayMessage(msg.sender or "Unknown", msg.content or "", msg.realName or "", false, msg.target)

                            if not msg.target or msg.target == "" or msg.target == LocalPlayer.DisplayName then
                                showNotification(msg.sender or "Unknown", msg.content or "", msg.realName or "")
                                task.spawn(function()
                                    local player = Players:FindFirstChild(msg.realName or "")
                                    if player and player.Character and player.Character:FindFirstChild("Head") then
                                        TextChatService:DisplayBubble(player.Character.Head, msg.content)
                                    end
                                end)
                            end
                        end
                    end
                end
            end
        end
    end

