    -- ===== Message Filter =====
    local function filterMessage(msg)
        if msg:find("<[^>]*>") then return true, "HTML tags not allowed" end
        if msg:find("[<>]") then return true, "Angle brackets not allowed" end
        if msg:find("[\204-\205][\128-\191]") then return true, "Zalgo text not allowed" end
        local letters = msg:gsub("[^%a]", "")
        if #letters > 0 and letters:match("(.)%1{15,}") then return true, "Too many repeated letters" end
        if #letters > 10 then
            local upper = select(2, letters:gsub("%u", ""))
            if upper / #letters > 0.8 and upper > 15 then
                return true, "Too many capital letters"
            end
        end
        return false, msg
    end

    -- ===== Send Message =====
