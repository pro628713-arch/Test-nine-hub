        weld(ring2, eye, CFrame.new(0.15, 0.15, 0.1))

        task.spawn(function()
            while model and model.Parent do
                if player == LocalPlayer and not u5 then
                    base.Transparency = 1
                    ring1.Transparency = 1
                    ring2.Transparency = 1
                    eye.Transparency = 1
                    repeat RunService.Heartbeat:Wait() until u5 or not model.Parent
                    base.Transparency = 0.1
                    ring1.Transparency = 0.1
                    ring2.Transparency = 0.1
                    eye.Transparency = 0.2
                end

                local t = tick()
                motor.C0 = CFrame.new(0, 5.5 + math.sin(t * 2) * 0.2, 0) * CFrame.Angles(0, math.pi, 0)
                ring1.Transparency = 0.1 + 0.1 * math.sin(t * 3)
                ring2.Transparency = 0.1 + 0.1 * math.sin(t * 4)
                eye.Transparency = 0.2 + 0.1 * math.sin(t * 5)
                RunService.Heartbeat:Wait()
            end
        end)
    end

    -- ===== Apply Auras to Existing Players =====
    for _, player in ipairs(Players:GetPlayers()) do
        local function applyAura(character)
            if character then
                local root = character:WaitForChild("HumanoidRootPart", 10)
                if character:FindFirstChild("MickeyAura") then
                    character.MickeyAura:Destroy()
                end
                local roleData = t4[player.Name] or t4[player.DisplayName]
                if roleData and roleData.Style then
